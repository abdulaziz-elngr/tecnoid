# ==========================================================
# TecnoID Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ==========================================================

# --- Database (PostgreSQL) ---
# Example: postgresql://tecnoid_user:strong_password@localhost:5432/tecnoid?schema=public
DATABASE_URL="postgresql://tecnoid_user:CHANGE_ME@localhost:5432/tecnoid?schema=public"

# --- Redis (caching, queues, rate limiting) ---
REDIS_URL="redis://localhost:6379"

# --- Auth / Sessions ---
# Generate with: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
SESSION_COOKIE_NAME="tecnoid_session"
SESSION_TTL_MINUTES="60"
SESSION_ABSOLUTE_TTL_HOURS="24"

# --- App ---
NEXT_PUBLIC_APP_NAME="TecnoID"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- File Storage (S3-compatible) ---
STORAGE_PROVIDER="s3"          # s3 | vercel-blob | local (local for dev only)
STORAGE_BUCKET="tecnoid-uploads"
STORAGE_REGION="me-south-1"
STORAGE_ENDPOINT=""            # set for S3-compatible providers (e.g. MinIO, DigitalOcean Spaces)
STORAGE_ACCESS_KEY_ID="CHANGE_ME"
STORAGE_SECRET_ACCESS_KEY="CHANGE_ME"

# --- WhatsApp Business Platform (Meta official API) ---
# Leave blank to keep the integration disabled; the UI will show
# "Integration not configured" instead of silently failing.
WHATSAPP_PROVIDER="meta"
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Bearer token the WhatsApp queue worker endpoint requires. Leave blank
# to keep POST /api/whatsapp/worker disabled (it is not session-protected).
WORKER_SECRET=""

# --- Local file storage (used when STORAGE_PROVIDER=local, e.g. dev) ---
STORAGE_LOCAL_DIR="./storage/uploads"
STORAGE_PUBLIC_PREFIX="/api/files"
MAX_UPLOAD_IMAGE_BYTES="3145728"
MAX_UPLOAD_DOC_BYTES="10485760"

# --- Employee attendance ---
# Standard work-day length in minutes, used to flag EARLY_LEAVE / OVERTIME.
STANDARD_WORK_MINUTES="480"

# --- Phone number normalization ---
# Default country calling code (no +) used when a phone number is
# entered without one, e.g. "20" for Egypt.
DEFAULT_COUNTRY_CODE="20"

# --- Email (transactional) ---
EMAIL_PROVIDER=""               # e.g. resend, ses, smtp — blank disables email
EMAIL_FROM="TecnoID <no-reply@tecnoid.example>"
EMAIL_API_KEY=""

# --- Rate limiting ---
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MINUTES="15"

# --- Backups ---
BACKUP_STORAGE_BUCKET="tecnoid-backups"
BACKUP_RETENTION_DAYS="30"
